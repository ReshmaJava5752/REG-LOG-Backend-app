# RegistrationLoginProject Environment Variables
#
# Copy this file to .env (project root or backend/ folder) and replace the placeholder
# values with real secrets. The backend loads .env automatically via spring.config.import.
# Real environment variables always win over values in .env.
#
# Do NOT commit the .env file — it is listed in .gitignore.

# MySQL database password (backend)
# Used by: spring.datasource.password
DB_PASSWORD=your_mysql_password_here

# JWT signing secret (backend)
# Must be at least 256 bits (32+ characters) for HS256.
# Used by: app.jwt.secret
JWT_SECRET=your_256_bit_or_longer_secret_key_here

# ---------------------------------------------------------------------------
# Gmail SMTP (used to deliver password-reset OTP e-mails)
# ---------------------------------------------------------------------------
# SMTP host. Gmail's server is smtp.gmail.com.
SMTP_HOST=smtp.gmail.com

# SMTP port. Use 587 for STARTTLS (recommended). Use 465 only if you switch to SSL.
SMTP_PORT=587

# SMTP protocol. 'smtp' pairs with STARTTLS on port 587.
SMTP_PROTOCOL=smtp

# The full Gmail address used to authenticate and to send the OTP e-mail,
# for example youraccount@gmail.com
SMTP_USERNAME=your_gmail_address@gmail.com

# A Google App Password, NOT the regular Gmail account password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account).
SMTP_PASSWORD=your_16_character_google_app_password

# Optional: the "From" address shown on the OTP e-mail.
# Defaults to SMTP_USERNAME when omitted.
SMTP_FROM=your_gmail_address@gmail.com

# ---------------------------------------------------------------------------
# OTP delivery mode
# ---------------------------------------------------------------------------
# 'smtp'   - send the OTP by e-mail (default, use this)
# 'console' - print the OTP to the backend console instead of sending e-mail.
#             Local development only; never use in a deployed environment.
OTP_DELIVERY_MODE=smtp

# ---------------------------------------------------------------------------
# Secret for the password reset codes
# ---------------------------------------------------------------------------
# The backend stores an HMAC-SHA256 fingerprint of the reset code, never the code
# itself. This secret is used to compute that fingerprint. It defaults to
# JWT_SECRET, so setting JWT_SECRET is enough - set OTP_HMAC_SECRET only if the
# reset codes should have a secret of their own.
# Used by: app.otp.hmac-secret
# OTP_HMAC_SECRET=your_256_bit_or_longer_secret_key_here

# ---------------------------------------------------------------------------
# Console delivery safety switch
# ---------------------------------------------------------------------------
# The 'console' delivery mode prints the reset code to the server log. That is
# only allowed when this is explicitly set to true, so a misconfigured
# deployment can never write codes into the log by accident.
# Used by: app.otp.allow-console-logging
OTP_ALLOW_CONSOLE_LOGGING=false
